{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/chart-contract/blob/main/schemas/audit-profile-diff-v1.schema.json",
  "title": "chart-contract audit profile diff v1",
  "description": "Mechanical drift between two saved chart-contract audit profile manifests. It does not classify compatibility, safety, or scientific quality.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "semantic_changed",
    "tool_metadata_changed",
    "before",
    "after",
    "profile_changes",
    "rules_added",
    "rules_removed",
    "rules_changed",
    "rule_order_changed",
    "before_rule_order",
    "after_rule_order",
    "compatibility_judgment"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "chart_contract.audit_profile_diff"},
    "semantic_changed": {"type": "boolean"},
    "tool_metadata_changed": {"type": "boolean"},
    "before": {"$ref": "#/$defs/side"},
    "after": {"$ref": "#/$defs/side"},
    "profile_changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldChange"}
    },
    "rules_added": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "rules_removed": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "rules_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "changes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/fieldChange"}
          }
        },
        "additionalProperties": false
      }
    },
    "rule_order_changed": {"type": "boolean"},
    "before_rule_order": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "after_rule_order": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "compatibility_judgment": {"type": "null"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["algorithm", "canonicalization", "profile", "profile_manifest_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "audit-profile-semantics-v1"},
        "profile": {"type": "string", "minLength": 1},
        "profile_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "side": {
      "type": "object",
      "required": ["profile", "binding"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "binding": {"$ref": "#/$defs/binding"}
      },
      "additionalProperties": false
    },
    "fieldChange": {
      "type": "object",
      "required": ["field", "before", "after"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "before": {},
        "after": {}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "applies_to", "severities", "trigger", "known_boundary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "applies_to": {"type": "array", "items": {"enum": ["chart", "spec"]}},
        "severities": {"type": "array", "items": {"enum": ["PASS", "WARN", "FAIL"]}},
        "trigger": {"type": "string", "minLength": 1},
        "known_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
