{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/chart-contract/blob/main/schemas/audit-bundle-v1.schema.json",
  "title": "chart-contract audit bundle manifest v1",
  "description": "Closed manifest for explicitly required identity parity across two or more chart artifacts.",
  "type": "object",
  "required": [
    "version",
    "artifacts",
    "relationships"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "spec"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "artifact_ids",
          "equal_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "equal_on": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "analysis_scope",
                "metric_definition",
                "unit",
                "time_window"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
