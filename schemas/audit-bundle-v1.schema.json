{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/chart-contract/blob/main/schemas/audit-bundle-v1.schema.json",
  "title": "chart-contract audit bundle manifest v1",
  "description": "Closed manifest for explicit cross-chart identity and additive total reconciliation obligations.",
  "type": "object",
  "required": [
    "version",
    "artifacts",
    "relationships"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "spec"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "artifact_ids",
              "equal_on"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "artifact_ids": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "equal_on": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "analysis_scope",
                    "metric_definition",
                    "unit",
                    "time_window"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "id",
              "total_artifact_id",
              "components_artifact_id",
              "total_metric_field",
              "component_field",
              "component_metric_field",
              "components_exhaustive",
              "tolerance"
            ],
            "properties": {
              "kind": {
                "const": "sum_reconciliation"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "total_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "components_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "total_metric_field": {
                "type": "string",
                "minLength": 1
              },
              "component_field": {
                "type": "string",
                "minLength": 1
              },
              "component_metric_field": {
                "type": "string",
                "minLength": 1
              },
              "components_exhaustive": {
                "const": true
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
