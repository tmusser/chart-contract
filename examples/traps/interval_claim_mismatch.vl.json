{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "title": "Observed estimates",
  "layer": [
    {
      "mark": "line",
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "estimate", "type": "quantitative"}
      }
    },
    {
      "mark": "rule",
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "lower", "type": "quantitative"},
        "y2": {"field": "upper"}
      }
    }
  ],
  "usermeta": {
    "source": "synthetic.interval_semantics",
    "unit": "users",
    "uncertainty_contract": {
      "version": 1,
      "estimate_field": "estimate",
      "lower_field": "lower",
      "upper_field": "upper",
      "interval_kind": "credible",
      "interval_level": 0.9,
      "interval_method": "posterior_quantiles"
    }
  }
}
